{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:above_preliminary_surface"
  },
  "then_run": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": [
        "climaterivers:cold_river",
        "climaterivers:lukewarm_river",
        "climaterivers:warm_river"
      ]
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": "minecraft:on_floor",
          "then_run": {
            "type": "minecraft:condition",
            "if_true": "minecraft:not_underwater",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                "climaterivers:river/biome_top",
                {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:water",
                        "add_stone_depth": false,
                        "offset": 0,
                        "surface_depth_multiplier": 0
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": "minecraft:grass_block"
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": "minecraft:dirt"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": "minecraft:not_under_deep_water",
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": "minecraft:under_floor",
                "then_run": {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:water",
                        "add_stone_depth": false,
                        "offset": 0,
                        "surface_depth_multiplier": 0
                      },
                      "then_run": "climaterivers:river/biome_top"
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": "minecraft:dirt"
                    }
                  ]
                }
              },
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:biome",
                  "biome_is": "climaterivers:warm_river"
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:deep_under_floor",
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:sandstone"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": "minecraft:on_floor",
          "then_run": {
            "type": "minecraft:sequence",
            "sequence": [
              {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:biome",
                  "biome_is": [
                    "climaterivers:warm_river",
                    "climaterivers:lukewarm_river"
                  ]
                },
                "then_run": "minecraft:overworld/sand_or_sandstone_if_ceiling"
              },
              "minecraft:overworld/gravel_or_stone_if_ceiling"
            ]
          }
        }
      ]
    }
  }
}